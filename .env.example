APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

# ── Compte administrateur (requis par AdminSeeder, voir php artisan
# db:seed) — sans ADMIN_PASSWORD le seeder lève une exception.
ADMIN_EMAIL=admin@claireafrique.sn
ADMIN_PASSWORD=

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ClaireAfrique nécessite MySQL (types ENUM natifs, InnoDB) — voir README.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=claireafrique
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# "sync" : les emails (confirmation de commande, réinitialisation de mot
# de passe) partent dans la même requête, sans worker à lancer en plus —
# cohérent avec le choix "rester en synchrone" déjà fait pour les
# notifications in-app. À passer sur "database" + un worker
# (php artisan queue:work) uniquement si le volume de commandes le
# justifie un jour.
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# À remplacer par de vrais identifiants SMTP (ex. Mailtrap en dev, ou le
# SMTP fourni par ton hébergeur OVH en prod) — voir README.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@claireafrique.sn"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ── PayDunya (agrégateur Wave / Orange Money) — voir config/paydunya.php
# et https://developers.paydunya.com/doc/FR/php. 'test' en local, 'live'
# en production (identifiants distincts entre les deux modes chez PayDunya).
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_PUBLIC_KEY=
PAYDUNYA_TOKEN=
PAYDUNYA_MODE=test

# ── Informations boutique (config/claireafrique.php)
NOM_BOUTIQUE=ClaireAfrique
WAVE_NUMERO=+221770000000
OM_NUMERO=+221760000000
FRAIS_LIVRAISON=2000

# Délai (en heures) avant expiration automatique d'une commande "espèces"
# non honorée — voir ExpirerCommandesEspecesNonHonorees.
COMMANDE_DELAI_EXPIRATION_ESPECES_HEURES=48
